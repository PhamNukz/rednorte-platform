# ── Secretos JWT ────────────────────────────────────────────────────────────
JWT_SECRET=cambia_esto_por_un_secreto_seguro_256bits

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_USER=admin
RABBITMQ_PASS=admin123

# ── PostgreSQL (contraseña compartida por todos los servicios) ────────────────
DB_USER=postgres
DB_PASS=postgres123

# ── Nombres de bases de datos ─────────────────────────────────────────────────
DB_ESPERA_NAME=db_espera
DB_REASIG_NAME=db_reasignacion
DB_PACIENTES_NAME=db_pacientes
DB_DISPON_NAME=db_disponibilidad

# ── SMTP (para ms-notificaciones) ─────────────────────────────────────────────
